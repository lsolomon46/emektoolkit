    return `<div class="lvlcard" data-lvl="${l.id}" style="${sug?'border-color:var(--gold); border-width:2.5px;':''}"><div class="lid">Level ${l.id}</div><div class="ldesc">${l.desc}</div>${sugTag}${score}</div>`;
  }).join("");
  if(!effectiveShowA) html += `<div class="lvlcard" id="showA" style="border-style:dashed; opacity:.75"><div class="lid" style="font-size:15px">+ Show Level A</div><div class="ldesc">Letter/vowel recognition. Rarely needed in grades 3–8; tap only for a student who cannot access Level B.</div></div>`;
