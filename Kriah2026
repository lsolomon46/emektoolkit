    teacherName = j.teacherName || name; teacherRoster = j.roster || []; teacherResults = j.results || [];
    teacherSections = j.sections || [];
    doneMap = {}; flagsMap = {}; diagMap = {};
    (j.done || []).forEach(d => {
      doneMap[d.name + "|" + d.window] = d.parts;
      if(d.flags && d.flags.length) flagsMap[d.name + "|" + d.window] = d.flags;
    });
    (j.diagDone || []).forEach(d => {
      const k2 = d.name + "|" + d.window;
