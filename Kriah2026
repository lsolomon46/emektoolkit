const BAND_PILL = {Benchmark:"background:#E3F1E8;color:#2E7D4F", Strategic:"background:#FBF3D9;color:#8a6d00", Intensive:"background:#FBEAE8;color:#C0392B"};
function pill(band){ return band ? `<span class="rr-pill" style="${BAND_PILL[band]||""}">${band}</span>` : ""; }
function esc(t){ return String(t==null?"":t).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
function fmtDate(d){ return new Date(d || Date.now()).toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"}); }
function partTitle(code, grade){ return code==="1" ? "Part 1 · " + (+grade <= 5 ? "Word Reading" : "Word Screener") : code==="A" ? "Passage A · Familiar" : "Passage B · Unfamiliar"; }
function recFromLive(){
  const r = S.result, g = S.grade, parts = [];
  [["1","p1"],["A","pA"],["B","pB"]].forEach(([code,key])=>{
    const P = S.parts[key]; if(!P) return;
    const score = code==="1" ? P.cspm : P.wcpm;
    const band = bandOf(score, (code==="1" ? BENCH.cspm : BENCH.wcpm)[g])[0];
    parts.push({ code, title:partTitle(code,g), measure: code==="1" ? "CSPM" : "WCPM", score, band, acc:P.acc, read:P.read, errors:P.errors, items:P.allItems, missed:P.missedWords||[] });
  });
  return { name:r.name, grade:g, window:r.window, date:r.timestamp, examiner:r.examiner, gap:r.gap, gapFlag:r.gapFlag, tally:r.tally||{}, parts,
           notes:{ rs:r.readingStyle||[], bh:r.behavior||[], txt:r.notes||"" }, live:true };
}
function recFromRow(r){
  const g = r.grade, parts = [], m = r.missed || {};
  if(r.cspm != null) parts.push({ code:"1", title:partTitle("1",g), measure:"CSPM", score:r.cspm, band:r.band1, acc:r.acc1, read:r.syllRead, errors:r.syllErrors, missed:m["1"]||[] });
  if(r.wcpmA != null) parts.push({ code:"A", title:partTitle("A",g), measure:"WCPM", score:r.wcpmA, band:r.bandA, acc:r.accA, read:r.wordsA, errors:r.errA, missed:m["A"]||[] });
  if(r.wcpmB != null) parts.push({ code:"B", title:partTitle("B",g), measure:"WCPM", score:r.wcpmB, band:r.bandB, acc:r.accB, read:r.wordsB, errors:r.errB, missed:m["B"]||[] });
  return { name:r.name, grade:g, window:r.window, date:r.ts, examiner:r.examiner, gap:r.gap==null?"":r.gap, gapFlag:r.gapFlag, tally:r.tally||{}, parts, notes:null, live:false };
}
function benchLine(code, g){
  const b = (code==="1" ? BENCH.cspm : BENCH.wcpm)[g]; return b ? `Benchmark ${b[0]}+ &middot; Strategic ${b[1]}+` : "";
}
