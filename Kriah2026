    S.parts.p1 = { read:read.length, errors:errs.length, elapsed, cspm:Math.round((read.length-errs.length)/elapsed*60), acc:read.length? Math.round((read.length-errs.length)/read.length*1000)/10 : 0, tally, missedWords, allItems };
