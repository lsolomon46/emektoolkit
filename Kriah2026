$("examinerToggle").addEventListener("click", ()=>{ $("examinerBox").style.display = "block"; $("examinerToggle").style.display = "none"; $("examiner").focus(); });
async function tryResume(){
  let r = null;
  try{ r = JSON.parse(sessionStorage.getItem("kriahResume") || "null"); sessionStorage.removeItem("kriahResume"); }catch(e){}
  if(!r) return;
  try{
    if(r.role === "teacher"){
      const res = await loadTeacher(r.name);
      if(!res.ok) return;
      resumeInfo = {role:"teacher", name:r.name};
      enterAsTeacher();
    } else if(r.role === "admin"){
      const ok = await loadAdmin(r.key, true);
      if(!ok) return;
      scopeRoster = roster; resumeInfo = {role:"admin", key:r.key};
      enterAsAdmin();
    } else return;
    if(r.win){ $("windowSel").value = r.win; $("windowSel").dispatchEvent(new Event("change")); }
    if(r.cls){ $("classSel").value = r.cls; $("classSel").dispatchEvent(new Event("change")); }
    if(r.stu){ $("studentSel").value = r.stu; $("studentSel").dispatchEvent(new Event("change")); }
  }catch(e){}
}
loadTeachers();
tryResume();
</script>
