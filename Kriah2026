function bandOf(val, pair){ return val>=pair[0] ? ["Benchmark","b-bench"] : val>=pair[1] ? ["Strategic","b-strat"] : ["Intensive","b-int"]; }
function accBand(a){ return a>=BENCH.acc[0]?["Benchmark","b-bench"]:a>=BENCH.acc[1]?["Strategic","b-strat"]:["Intensive","b-int"]; }

function recomputePart(key){
  const P = S.parts[key]; if(!P || !P.allItems) return;
  const read = P.allItems.filter(i=>i.read), errs = read.filter(i=>i.err);
  const rate = Math.round((read.length - errs.length) / P.elapsed * 60);
  P.read = read.length; P.errors = errs.length;
  if(key === "p1") P.cspm = rate; else P.wcpm = rate;
  P.acc = read.length ? Math.round((read.length - errs.length) / read.length * 1000) / 10 : 0;
  const tally = {};
  errs.forEach(i=>String(i.skills || i.skill || "Gen").split("·").forEach(k=>{ tally[k] = (tally[k]||0) + 1; }));
  P.tally = tally;
  P.missedWords = [...new Set(errs.map(i=>i.text))];
}
