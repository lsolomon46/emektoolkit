    const missed = DG.cur.items.filter((_,i)=>!DG.answers[i]);
    DG.done[DG.cur.id] = { correct: DG.answers.filter(Boolean).length, total: DG.cur.items.length, missed };
    renderLevels(); show("scr-levels");
  } else renderDiagItem();
}
