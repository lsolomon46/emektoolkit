const BUCKET = {A:"letters", B:"letters", C:"letters", E:"letters", F:"letters",
  D:"nikud", I:"nikud", J:"nikud", Ch:"nikud",
  G:"rules", H:"rules", K:"rules", L:"rules", Gen:"gen"};
const BUCKET_LABEL = {letters:"Letters", nikud:"Nikudos", rules:"Rules & Dagesh", gen:"General"};
function bucketOf(skill){ return BUCKET[skill] || "gen"; }
function renderLegend(){
