function tagWord(w){
  if(/[חהע]ַ\u05BC?$/.test(w) || /הַּ$/.test(w)) return "G";        // patach genuva
  if(/[\u05B1\u05B2\u05B3]/.test(w)) return "Ch";                    // chataf vowels
  if(/^ו[\u05B0\u05B7\u05B8\u05BC]/.test(w)) return "K";              // vav prefix
  if(/\u05B0/.test(w)) return "L";                                   // shva
  if(/וֹ/.test(w) || /וּ/.test(w)) return "D";                       // cholom malei / shuruk
  if(/ה$/.test(w)) return "H";                                       // silent hei
  if(/[ןםךףץ]/.test(w)) return "F";                                  // sofiot
  return "Gen";
}

