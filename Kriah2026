<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Kriah Exam (Decoding and Fluency) · Grades 2-8 · Emek Hebrew Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=David+Libre:wght@400;500;700&family=Nunito+Sans:wght@400;600;700;800&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#1C4FA0; --navy-deep:#143B7A; --blue:#2466CC; --gold:#F5A623; --gold-soft:#FCE3B0;
  --paper:#F6F8FC; --ink:#1E2430; --line:#D5DCEA;
  --err:#C0392B; --err-bg:#FBEAE8; --ok:#2E7D4F; --grey:#8A8578;
  --bkt-letters:#C0392B; --bkt-letters-bg:#FBEAE8;
  --bkt-nikud:#96690A; --bkt-nikud-bg:#FBF3D9;
  --bkt-rules:#5B3E96; --bkt-rules-bg:#EFE8FA;
  --bkt-gen:#5A5648; --bkt-gen-bg:#EEEAE0;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
body{margin:0; font-family:'Nunito Sans',system-ui,sans-serif; background:var(--paper); color:var(--ink);}
.screen{display:none; max-width:880px; margin:0 auto; padding:20px 18px 60px;}
.screen.active{display:block;}
header.app{background:#fff; color:var(--navy); padding:10px 18px; display:flex; align-items:center; gap:14px; border-bottom:4px solid var(--gold);}
header.app img.logo{height:46px; width:auto; display:block;}
header.app .titles{display:flex; flex-direction:column; gap:2px;}
header.app h1{font-family:'Montserrat',sans-serif; font-size:17px; margin:0; font-weight:800; letter-spacing:.01em; color:var(--navy);}
header.app .band{color:#5B6578; font-weight:600; font-size:12px; white-space:nowrap;}
header.app .who{margin-left:auto; font-size:14px; font-weight:600; color:var(--navy);}
h2.step{font-family:'Montserrat',sans-serif; font-size:14px; text-transform:uppercase; letter-spacing:.12em; color:var(--navy); margin:26px 0 6px; border-bottom:2px solid var(--gold); padding-bottom:6px; display:flex; align-items:baseline;}
h2.step .hint{margin-left:auto; text-transform:none; letter-spacing:0; font-weight:400; color:var(--grey); font-size:13px;}
label{display:block; font-weight:600; font-size:14px; margin:14px 0 4px;}
select,input[type=text]{width:100%; padding:11px 12px; font-size:16px; border:1.5px solid var(--line); border-radius:8px; background:#fff; font-family:inherit;}
button{font-family:inherit; cursor:pointer; border:none; border-radius:10px; font-weight:700;}
.btn-primary{background:var(--navy); color:#fff; font-size:17px; padding:14px 26px; width:100%; margin-top:20px;}
.btn-primary:disabled{background:#B8BCC6;}
.btn-ghost{background:none; color:var(--navy); font-size:14px; padding:10px 4px; text-decoration:underline; font-weight:600;}
.btn-stop{background:var(--err); color:#fff; font-size:15px; padding:10px 18px;}
.notice{font-size:13.5px; background:#fff; border:1px solid var(--line); border-left:4px solid var(--gold); border-radius:8px; padding:10px 12px; margin:12px 0; color:#4A4638;}
.notice.err{border-left-color:var(--err); color:var(--err);}
/* timer bar */
.timerbar{position:sticky; top:0; z-index:5; background:var(--paper); padding:10px 0 8px; display:flex; align-items:center; gap:14px; border-bottom:1px solid var(--line);}
.ring{width:64px; height:64px; flex:0 0 64px;}
.ring text{font:700 20px 'Montserrat'; fill:var(--navy);}
.ring.warn text{fill:var(--err);}
.ring circle.track{fill:none; stroke:#E7E1D2; stroke-width:6;}
.ring circle.prog{fill:none; stroke:var(--navy); stroke-width:6; stroke-linecap:round; transform:rotate(-90deg); transform-origin:50% 50%; transition:stroke .3s;}
.ring.warn circle.prog{stroke:var(--err);}
.tstate{font-size:14px; color:var(--grey); flex:1;}
.tstate b{color:var(--navy); display:block; font-size:15px;}
/* word grid */
.grid{direction:rtl; display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:14px;}
.word{background:#fff; border:1.5px solid var(--line); border-radius:10px; padding:8px 6px 10px; text-align:center; display:flex; justify-content:center; direction:rtl;}
.seg{font-family:'David Libre',serif; font-size:30px; line-height:1.5; padding:0 3px; border-radius:6px; cursor:pointer; border-bottom:3px solid transparent;}
.seg + .seg{margin-right:2px; border-right:1px dotted #CFC7B4;}
.seg.err{color:var(--err); background:var(--err-bg); border-bottom-color:var(--err);}
/* passage */
.passage{direction:rtl; font-family:'David Libre',serif; font-size:32px; line-height:2.15; background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:18px 22px; margin-top:14px;}
.pw{cursor:pointer; padding:1px 4px; border-radius:6px; border-bottom:3px solid transparent;}
.pw.err{color:var(--err); background:var(--err-bg); border-bottom-color:var(--err);}
.beyond{opacity:.22;}
.lastmark{outline:3px solid var(--gold); outline-offset:2px; border-radius:6px;}
.pick-last .seg,.pick-last .pw{cursor:crosshair;}
/* results */
.scorecards{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-top:14px;}
.card{background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:14px; text-align:center;}
.card .n{font-size:34px; font-weight:700; color:var(--navy); line-height:1;}
.card .l{font-size:12.5px; text-transform:uppercase; letter-spacing:.08em; color:var(--grey); margin-top:6px;}
.card .band-tag{display:inline-block; margin-top:8px; font-size:12px; font-weight:700; padding:3px 10px; border-radius:20px;}
.b-bench{background:#E3F1E8; color:var(--ok);} .b-strat{background:#FBF3D9; color:#8a6d00;} .b-int{background:var(--err-bg); color:var(--err);}
table.skills{width:100%; border-collapse:collapse; margin-top:10px; background:#fff; border-radius:10px; overflow:hidden; border:1.5px solid var(--line);}
table.skills th{background:var(--navy); color:#fff; font-size:12.5px; padding:8px 4px;}
table.skills td{text-align:center; padding:9px 4px; font-size:16px; border-top:1px solid var(--line);}
table.skills td.hot{background:var(--err-bg); color:var(--err); font-weight:700;}
.gapflag{margin-top:14px; padding:12px 14px; border-radius:10px; font-size:15px;}
.gapflag.bad{background:var(--err-bg); border:1px solid var(--err); color:var(--err);}
.gapflag.good{background:#E3F1E8; border:1px solid var(--ok); color:var(--ok);}
.saveline{margin-top:18px; font-size:14.5px; font-weight:600;}
.saveline.ok{color:var(--ok);} .saveline.fail{color:var(--err);}
/* analytics */
.anlfilters{display:flex; gap:12px; margin-top:10px; flex-wrap:wrap;}
.anlfilters select{flex:1; min-width:130px;}
.stack{display:flex; height:30px; border-radius:8px; overflow:hidden; margin:4px 0 2px; background:#EEE9DC;}
.stack div{color:#fff; font-size:12.5px; font-weight:700; display:flex; align-items:center; justify-content:center; min-width:0;}
.st-b{background:var(--ok);} .st-s{background:#C9A227;} .st-i{background:var(--err);}
.stlbl{font-size:13px; font-weight:600; margin-top:12px;}
.hrow{display:flex; align-items:center; gap:8px; margin:5px 0;}
.hrow .hl{width:44px; font-size:13px; font-weight:700; color:var(--navy); text-align:right;}
.hrow .htrack{flex:1; background:#EEE9DC; border-radius:6px; height:20px;}
.hrow .hfill{background:var(--navy); height:100%; border-radius:6px; min-width:2px;}
.hrow .hn{width:34px; font-size:13px; color:var(--grey);}
/* diagnostic */
.lvlgrid{display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:12px; margin-top:14px;}
.lvlcard{background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:14px; cursor:pointer;}
.lvlcard:hover{border-color:var(--navy);}
.lvlcard .lid{font-size:22px; font-weight:700; color:var(--navy);}
.lvlcard .ldesc{font-size:13px; color:var(--grey); margin-top:2px;}
.lvlcard .lscore{margin-top:8px; font-size:13px; font-weight:700;}
.lvlcard .lscore.good{color:var(--ok);} .lvlcard .lscore.mid{color:#8a6d00;} .lvlcard .lscore.low{color:var(--err);}
.diagbig{direction:rtl; font-family:'David Libre',serif; font-size:96px; text-align:center; background:#fff; border:1.5px solid var(--line); border-radius:16px; padding:50px 20px; margin-top:16px; min-height:220px; display:flex; align-items:center; justify-content:center;}
.diagmeta{display:flex; justify-content:space-between; align-items:baseline; margin-top:14px; font-size:14px; color:var(--grey);}
.diagbtns{display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:16px;}
.btn-correct{background:var(--ok); color:#fff; font-size:19px; padding:18px;}
.btn-wrong{background:var(--err); color:#fff; font-size:19px; padding:18px;}
@media (max-width:560px){ .diagbig{font-size:64px; min-height:160px;} .grid{grid-template-columns:repeat(3,1fr);} .seg{font-size:26px;} .passage{font-size:27px;} }
/* practice sheet */
.wsHeader{border-bottom:2px solid var(--gold); padding-bottom:10px; margin-bottom:16px;}
.wsSchool{font-size:12.5px; text-transform:uppercase; letter-spacing:.1em; color:var(--grey);}
.wsTitle{font-size:22px; font-weight:700; color:var(--navy); margin-top:2px;}
.wsSub{font-size:14px; color:var(--grey); margin-top:2px;}
.wsSkill{background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:12px;}
.wsSkillHead{font-weight:700; color:var(--navy); font-size:15px; margin-bottom:8px;}
.wsCount{font-weight:400; color:var(--err); font-size:13px;}
.wsItems{direction:rtl; display:flex; flex-wrap:wrap; gap:10px;}
.wsItem{font-family:'David Libre',serif; font-size:24px; background:var(--paper); border:1px solid var(--line); border-radius:8px; padding:6px 12px;}
.wsSign{margin-top:24px; font-size:13px; color:var(--grey); font-style:italic;}
/* annotated results passage */
.wsLegend{display:flex; flex-wrap:wrap; gap:10px; margin:10px 0 4px; font-size:12.5px;}
.legchip{display:flex; align-items:center; gap:6px; padding:4px 10px; border-radius:20px; background:#fff; border:1px solid var(--line);}
.legchip .dot{width:10px; height:10px; border-radius:50%; display:inline-block;}
.annoBlock{margin-top:10px;}
.annoLabel{font-size:12.5px; font-weight:700; color:var(--grey); text-transform:uppercase; letter-spacing:.08em; margin:14px 0 4px;}
.annoPassage{direction:rtl; font-family:'David Libre',serif; font-size:26px; line-height:2.15; background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:16px 20px;}
.aw{padding:1px 5px; border-radius:6px; border-bottom:3px solid transparent;}
.aw.bkt-letters{color:var(--bkt-letters); background:var(--bkt-letters-bg); border-bottom-color:var(--bkt-letters);}
.aw.bkt-nikud{color:var(--bkt-nikud); background:var(--bkt-nikud-bg); border-bottom-color:var(--bkt-nikud);}
.aw.bkt-rules{color:var(--bkt-rules); background:var(--bkt-rules-bg); border-bottom-color:var(--bkt-rules);}
.aw.bkt-gen{color:var(--bkt-gen); background:var(--bkt-gen-bg); border-bottom-color:var(--bkt-gen);}
.aw.beyond{opacity:.28;}
.attnGrid{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-top:10px;}
.attnCard{background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:12px 14px;}
.attnCard .an{font-size:26px; font-weight:700;}
.attnCard .al{font-size:12px; color:var(--grey); text-transform:uppercase; letter-spacing:.06em; margin-top:2px;}
.attnCard .aw2{direction:rtl; font-family:'David Libre',serif; font-size:16px; margin-top:6px; line-height:1.6;}
/* session notes tags */
.tagGroupLabel{font-size:12.5px; font-weight:700; color:var(--grey); text-transform:uppercase; letter-spacing:.06em; margin-top:12px;}
.tagRow{display:flex; flex-wrap:wrap; gap:8px; margin:6px 0 4px;}
.tagChip{background:#fff; border:1.5px solid var(--line); border-radius:20px; padding:7px 14px; font-size:13px; font-weight:600; cursor:pointer; color:var(--ink); font-family:inherit;}
.tagChip.on{background:var(--navy); color:#fff; border-color:var(--navy);}
textarea{width:100%; padding:11px 12px; font-size:15px; border:1.5px solid var(--line); border-radius:8px; background:#fff; font-family:inherit; resize:vertical;}

/* ===== sign-in ===== */
body.on-signin{background:radial-gradient(900px 520px at 15% -10%, #3E86E0 0%, rgba(62,134,224,0) 60%), linear-gradient(160deg,#143B7A 0%,#1C4FA0 55%,#2466CC 100%); min-height:100vh;}
body.on-signin header.app{display:none;}
#scr-signin{max-width:none; padding:28px 16px; min-height:100vh; align-items:center; justify-content:center; flex-direction:column;}
#scr-signin.active{display:flex;}
.si-card{width:100%; max-width:420px; background:#fff; border-radius:20px; border-top:6px solid var(--gold); box-shadow:0 28px 70px rgba(8,25,60,.5); padding:32px 30px 24px;}
.si-logo{display:block; margin:0 auto 16px; height:76px; width:auto;}
.si-title{font-family:'Montserrat',sans-serif; font-size:22px; font-weight:800; text-align:center; color:var(--navy); margin:0;}
.si-sub{text-align:center; color:#5B6578; font-size:14px; margin:4px 0 20px;}
.si-tabs{display:grid; grid-template-columns:1fr 1fr; gap:4px; background:#EDF1F8; border-radius:12px; padding:4px; margin-bottom:6px;}
.si-tab{padding:10px 6px; border-radius:9px; background:none; color:#4A5568; font-size:14px; font-weight:700;}
.si-tab[aria-selected="true"]{background:#fff; color:var(--navy); box-shadow:0 1px 4px rgba(20,40,90,.2);}
.si-card label{margin:14px 0 6px; font-size:13px; color:#2D3748;}
.si-input{width:100%; padding:13px 14px; font-size:16px; border:1.5px solid #C9D3E4; border-radius:10px; background:#fff; font-family:inherit;}
.si-input:focus{outline:none; border-color:var(--blue); box-shadow:0 0 0 4px rgba(36,102,204,.18);}
.si-passwrap{position:relative;}
.si-passwrap .si-input{padding-right:64px;}
.si-eye{position:absolute; right:6px; top:50%; transform:translateY(-50%); background:none; color:var(--navy); font-size:13px; padding:8px 10px; font-weight:700;}
.si-remember{display:flex; gap:8px; align-items:center; margin:14px 0 0; font-weight:600; font-size:13px; color:#4A5568; cursor:pointer;}
.si-remember input{width:18px; height:18px; accent-color:var(--navy);}
.si-err{background:var(--err-bg); color:var(--err); border:1px solid #F0B8B1; border-radius:10px; padding:10px 12px; font-size:13.5px; margin-top:14px; font-weight:600;}
.si-go{width:100%; margin-top:18px; padding:15px; background:var(--navy); color:#fff; font-size:16px; border-radius:12px; font-weight:800; font-family:'Montserrat',sans-serif; display:flex; align-items:center; justify-content:center; gap:10px;}
.si-go:hover{background:var(--navy-deep);}
.si-go[disabled]{opacity:.75; cursor:progress;}
.si-spin{width:16px; height:16px; border:3px solid rgba(255,255,255,.4); border-top-color:#fff; border-radius:50%; animation:sispin .8s linear infinite; display:none;}
.si-go.busy .si-spin{display:inline-block;}
@keyframes sispin{to{transform:rotate(360deg);}}
.si-status{display:flex; align-items:center; justify-content:center; gap:8px; font-size:12.5px; color:#6B7487; margin-top:18px;}
.si-dot{width:8px; height:8px; border-radius:50%; background:#C9A227; flex:0 0 8px;}
.si-status.ok .si-dot{background:var(--ok);} .si-status.err .si-dot{background:var(--err);}
.si-help{text-align:center; font-size:12.5px; color:#6B7487; margin-top:10px;}
.si-foot{color:rgba(255,255,255,.85); font-size:12px; margin-top:22px; text-align:center; letter-spacing:.06em; text-transform:uppercase;}
/* ===== tap to correct ===== */
.aw.fixable{cursor:pointer;}
.aw.fixable:hover{outline:2px dashed var(--navy); outline-offset:1px;}
/* ===== running record ===== */
.rr-page{background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:22px 24px; -webkit-print-color-adjust:exact; print-color-adjust:exact;}
.rr-head{display:flex; align-items:center; gap:16px; border-bottom:3px solid var(--gold); padding-bottom:10px; margin-bottom:12px;}
.rr-head img{height:54px; width:auto;}
.rr-head .rr-ttl{font-family:'Montserrat',sans-serif; font-weight:800; font-size:20px; color:var(--navy);}
.rr-head .rr-sub{font-size:12.5px; color:var(--grey); margin-top:2px;}
.rr-info{display:grid; grid-template-columns:repeat(3,1fr); gap:6px 18px; font-size:13.5px; margin-bottom:12px;}
.rr-info b{color:var(--navy);}
table.rr-table{width:100%; border-collapse:collapse; font-size:13.5px; margin:8px 0 12px;}
table.rr-table th{background:var(--navy); color:#fff; padding:7px 8px; text-align:left; font-size:12.5px;}
table.rr-table td{border:1px solid var(--line); padding:7px 8px; vertical-align:top;}
table.rr-table td.c{text-align:center;}
.rr-pill{display:inline-block; font-size:12px; font-weight:800; padding:2px 9px; border-radius:20px;}
.rr-h{font-family:'Montserrat',sans-serif; font-size:12.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--navy); margin:14px 0 4px; border-bottom:1px solid var(--line); padding-bottom:3px;}
.rr-text{direction:rtl; font-family:'David Libre',serif; font-size:21px; line-height:2.2; border:1px solid var(--line); border-radius:8px; padding:8px 12px; margin-bottom:8px;}
.rr-text .rw{padding:0 3px;}
.rr-text .rw.err{border:1.6px solid #1E2430; border-radius:5px; background:var(--err-bg); color:var(--err); font-weight:700;}
.rr-text .rw.err::after{content:"\2717"; font-family:'Nunito Sans',sans-serif; font-size:11px; vertical-align:super; margin-right:1px;}
.rr-text .rw.beyond{opacity:.3;}
.rr-text .rr-stop{font-family:'Nunito Sans',sans-serif; font-size:11px; font-weight:800; color:var(--navy); background:var(--gold-soft); border-radius:5px; padding:1px 6px; margin:0 4px;}
.rr-chips{display:flex; flex-wrap:wrap; gap:6px;}
.rr-chip{font-size:12.5px; border:1px solid var(--line); border-radius:6px; padding:3px 8px; background:#fff;}
.rr-missed{direction:rtl; font-family:'David Libre',serif; font-size:19px; line-height:1.9;}
.rr-sign{display:flex; gap:30px; margin-top:22px; font-size:12.5px; color:var(--grey);}
.rr-sign span{flex:1; border-top:1px solid #8A8578; padding-top:4px;}
.rr-note{font-size:12px; color:var(--grey); margin-top:10px;}
table.rr-class td,table.rr-class th{font-size:12.5px;}
.rr-scroll{overflow-x:auto;}
.sum-wrap{background:#fff; border:1.5px solid var(--line); border-radius:12px; padding:14px 16px; margin-top:12px; -webkit-print-color-adjust:exact; print-color-adjust:exact;}
.sum-title{font-family:'Montserrat',sans-serif; font-size:12.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--navy);}
.sum-sub{font-size:12px; color:var(--grey); margin:2px 0 8px;}
.sum-cards{display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:8px; margin-bottom:6px;}
.sum-card{border:1px solid var(--line); border-radius:10px; padding:8px 10px; text-align:center;}
.sum-card .n{font-size:24px; font-weight:800; color:var(--navy); line-height:1.1;}
.sum-card .l{font-size:11.5px; color:var(--grey); margin-top:3px;}
.sum-card .s{font-size:11px; color:var(--grey);}
.sum-bar{display:flex; height:24px; border-radius:7px; overflow:hidden; background:#EEE9DC; margin:3px 0 1px;}
.sum-bar div{color:#fff; font-size:12px; font-weight:800; display:flex; align-items:center; justify-content:center; min-width:0;}
.sum-lbl{font-size:12.5px; font-weight:700; margin-top:8px; color:#2D3748;}
.sum-lbl span{font-weight:400; color:var(--grey);}
.sum-skills{display:flex; flex-wrap:wrap; gap:6px; margin-top:4px;}
.rr-miss-cell{direction:rtl; font-family:'David Libre',serif; font-size:15px; text-align:right;}
@media print{ .rr-page{border:none; padding:0;} #scr-runrec .btn-primary, #scr-runrec .btn-ghost{display:none !important;} }

@media print{
  header.app, .btn-ghost, .btn-primary{display:none !important;}
  .screen{display:none !important; max-width:none; padding:0;}
  .screen.active{display:block !important;}
  body{background:#fff;}
}
</style>
</head>
<body class="on-signin">
<header class="app"><img class="logo" alt="Emek Hebrew Academy" data-logo><div class="titles"><h1>Kriah Exam</h1><span class="band">Decoding and Fluency · Grades 2–8</span></div><span class="who" id="whoami"></span></header>

<!-- ============ SIGN IN ============ -->
<section class="screen active" id="scr-signin">
  <div class="si-card">
    <img class="si-logo" alt="Emek Hebrew Academy" data-logo>
    <h1 class="si-title">Kriah Exam</h1>
    <p class="si-sub">Decoding and Fluency Assessment</p>
    <div class="si-tabs" role="tablist">
      <button type="button" class="si-tab" role="tab" id="siTabTeacher" aria-selected="true">Teacher</button>
      <button type="button" class="si-tab" role="tab" id="siTabAdmin" aria-selected="false">Admin / Proctor</button>
    </div>
    <form id="siForm" autocomplete="on" novalidate>
