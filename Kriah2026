  const med = k => median(res.map(r=>r[k]).filter(v=>v!=null));
  const cnt = k => res.filter(r=>r[k]!=null).length;
  const lows = res.map(r=>{ const a=[r.acc1,r.accA,r.accB].filter(v=>v!=null); return a.length ? Math.min(...a) : null; }).filter(v=>v!=null);
  const avgAcc = lows.length ? Math.round(lows.reduce((a,b)=>a+b,0)/lows.length*10)/10 : null;
  const flags = res.filter(r=>r.gapFlag==="FLAG").length;
  const card = (n,l,sub) => `<div class="sum-card"><div class="n">${n==null?"—":n}</div><div class="l">${l}</div>${sub?`<div class="s">${sub}</div>`:""}</div>`;
  let h = `<div class="sum-wrap"><div class="sum-title">Class summary</div><div class="sum-sub">${tested} of ${total} students tested in ${esc(w)}. Medians are used so one very high or low score does not skew the picture.</div>`;
  if(!tested) return h + `<div class="rr-note" style="margin:0">No fluency results saved yet for this window.</div></div>`;
  h += `<div class="sum-cards">` +
    card(`${tested}/${total}`,"Tested") +
    card(med("cspm"),"Median CSPM · word list",`${cnt("cspm")} tested`) +
    card(med("wcpmA"),"Median WCPM · familiar",`${cnt("wcpmA")} tested`) +
    card(med("wcpmB"),"Median WCPM · unfamiliar",`${cnt("wcpmB")} tested`) +
    card(avgAcc==null?null:avgAcc+"%","Average accuracy","lowest part per student") +
    card(flags,"Gap flags","memorized-reading pattern") + `</div>`;
  const bar = (label, key, bandKey) => {
    const c = {Benchmark:0,Strategic:0,Intensive:0}; res.forEach(r=>{ if(r[key]!=null && c[r[bandKey]]!=null) c[r[bandKey]]++; });
    const n = c.Benchmark + c.Strategic + c.Intensive; if(!n) return "";
    const seg = (v,color,t)=> v ? `<div style="flex:${v}; background:${color}">${v} ${t}</div>` : "";
    return `<div class="sum-lbl">${label} <span>(${n} tested)</span></div><div class="sum-bar">${seg(c.Benchmark,"#2E7D4F","Benchmark")}${seg(c.Strategic,"#C9A227","Strategic")}${seg(c.Intensive,"#C0392B","Intensive")}</div>`;
  };
  h += bar("Word list · CSPM","cspm","band1") + bar("Passage A · familiar","wcpmA","bandA") + bar("Passage B · unfamiliar","wcpmB","bandB");
  const sums = {}; res.forEach(r=>Object.entries(r.tally||{}).forEach(([k,v])=>{ if(k!=="Gen" && SKILLS.includes(k)) sums[k]=(sums[k]||0)+v; }));
  const top = Object.entries(sums).filter(([,v])=>v>0).sort((a,b)=>b[1]-a[1]).slice(0,3);
  h += `<div class="sum-lbl">Top skills to target <span>(total errors across the class)</span></div>` +
    (top.length ? `<div class="sum-skills">${top.map(([k,v])=>`<span class="rr-chip"><b>${k}</b> ${SKILL_DESC[k]||""}: <b>${v}</b></span>`).join("")}</div>` : `<div class="rr-note" style="margin:0">No skill errors recorded.</div>`);
  return h + `</div>`;
}

