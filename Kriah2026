/* ============ TIMED PROBE ENGINE ============ */
function makeProbe(prefix, container, onDone){
  const scr = $("scr-"+prefix);
  const svg = scr.querySelector(".ring"), prog = svg.querySelector(".prog"), txt = svg.querySelector("text");
  const CIRC = 2*Math.PI*27; prog.style.strokeDasharray = CIRC; prog.style.strokeDashoffset = 0;
  const btn = $(prefix+"btn"), msg = $(prefix+"msg"), next = $(prefix+"next");
  let t0=null, timer=null, elapsed=60, phase="idle"; // idle→running→picklast→done
  function tick(){
    const el = (Date.now()-t0)/1000, left = Math.max(0, 60-el);
    txt.textContent = Math.ceil(left);
    prog.style.strokeDashoffset = CIRC*(el/60);
    if(left<=10) svg.classList.add("warn");
    if(left<=0){ stop(60); }
  }
  function stop(el){
    clearInterval(timer); elapsed = Math.min(60, el);
    phase = "picklast";
    container.classList.add("pick-last");
    msg.innerHTML = "<b style='color:var(--err)'>Time!</b> Now tap the LAST item the student read.";
    btn.style.display = "none";
  }
  btn.addEventListener("click", ()=>{
    if(phase==="idle"){ phase="running"; t0=Date.now(); timer=setInterval(tick,200); btn.textContent="Student finished page"; msg.textContent="Timer running. Tap errors as you hear them."; }
    else if(phase==="running"){ stop((Date.now()-t0)/1000); }
  });
  return {
    getPhase:()=>phase,
    getElapsed:()=>t0 ? (Date.now()-t0)/1000 : 0,
    finishPick(lastIdx){
      phase="done"; container.classList.remove("pick-last");
      msg.textContent = "Done. Review taps if needed, then continue.";
      next.style.display = "block";
      onDone(lastIdx, elapsed);
    }
  };
}

