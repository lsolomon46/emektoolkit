async function loadTeacher(name){
  if(SCRIPT_URL.startsWith("PASTE")) return {ok:false, msg:"Not connected to a Sheet yet."};
  try{
    const r = await fetch(SCRIPT_URL + "?action=teacher&name=" + encodeURIComponent(name));
