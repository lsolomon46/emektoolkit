/* ============ ANALYTICS ============ */
let anlCache = null;
function median(a){ if(!a.length) return null; const s=[...a].sort((x,y)=>x-y), m=Math.floor(s.length/2); return s.length%2?s[m]:Math.round((s[m-1]+s[m])/2); }
function stackBar(label, counts){
  const total = counts.B + counts.S + counts.I;
  if(!total) return "";
  const seg = (n, cls, txt) => n ? `<div class="${cls}" style="flex:${n}">${n} ${txt}</div>` : "";
  return `<div class="stlbl">${label}</div><div class="stack">` +
    seg(counts.B,"st-b","Benchmark") + seg(counts.S,"st-s","Strategic") + seg(counts.I,"st-i","Intensive") + `</div>`;
}
function bandCounts(rows, key){
  const c = {B:0,S:0,I:0};
  rows.forEach(r=>{ const b=r[key]; if(b==="Benchmark")c.B++; else if(b==="Strategic")c.S++; else if(b==="Intensive")c.I++; });
  return c;
}
let secOf = {};
function fillSections(){
  const cur = $("anlSec").value;
  const secs = [...new Set(Object.values(secOf).filter(Boolean))].sort();
  $("anlSec").innerHTML = '<option value="">All sections</option>' + secs.map(x=>`<option>${x}</option>`).join("");
  if(secs.includes(cur)) $("anlSec").value = cur;
}
function renderAnl(){
  const w = $("anlWin").value, g = $("anlGrade").value, sec = $("anlSec").value;
  const rows = (anlCache||[]).filter(r => (!w || r.window===w) && (!g || r.grade===g) && (!sec || secOf[r.name]===sec));
  const cspms = rows.map(r=>r.cspm).filter(v=>v!=null);
  const wbs = rows.map(r=>r.wcpmB).filter(v=>v!=null);
  const names = new Set(rows.map(r=>r.name));
  const flags = rows.filter(r=>r.gapFlag==="FLAG").length;
  const lowsA = rows.map(r=>{ const a=[r.acc1,r.accA,r.accB].filter(v=>v!=null); return a.length?Math.min(...a):null; }).filter(v=>v!=null);
  const avgAccAnl = lowsA.length ? Math.round(lowsA.reduce((a,b)=>a+b,0)/lowsA.length*10)/10 : null;
  $("anlCards").innerHTML = `
    <div class="card"><div class="n">${names.size}</div><div class="l">Students tested</div></div>
    <div class="card"><div class="n">${median(cspms) ?? "–"}</div><div class="l">Median CSPM</div></div>
    <div class="card"><div class="n">${median(wbs) ?? "–"}</div><div class="l">Median WCPM (unfamiliar)</div></div>
    <div class="card"><div class="n">${avgAccAnl==null?"–":avgAccAnl+"%"}</div><div class="l">Avg accuracy (lowest part)</div></div>
    <div class="card"><div class="n">${flags}</div><div class="l">Gap flags</div></div>`;
  $("anlBands").innerHTML =
    stackBar("Word list (CSPM)", bandCounts(rows.filter(r=>r.cspm!=null),"band1")) +
    stackBar("Passage A · familiar (WCPM)", bandCounts(rows.filter(r=>r.wcpmA!=null),"bandA")) +
    stackBar("Passage B · unfamiliar (WCPM)", bandCounts(rows.filter(r=>r.wcpmB!=null),"bandB")) ||
    "<div class='notice'>No data for this selection yet.</div>";
  const sums = {}; SKILLS.forEach(k=>sums[k]=0);
  rows.forEach(r=>Object.entries(r.tally||{}).forEach(([k,v])=>{ if(sums[k]!=null) sums[k]+=v; }));
  const mx = Math.max(1, ...Object.values(sums));
  $("anlErr").innerHTML = SKILLS.map(k=>
    `<div class="hrow"><span class="hl">${k}</span><div class="htrack"><div class="hfill" style="width:${Math.round(sums[k]/mx*100)}%"></div></div><span class="hn">${sums[k]}</span></div>`
  ).join("");
}
