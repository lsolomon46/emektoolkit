const probes = {};
function buildPassage(elId, lines, prefix, key){
  const box = $(elId); box.innerHTML = "";
  let idx = 0;
  lines.forEach(line=>{
    line.trim().split(/\s+/).forEach(w=>{
      const sp = document.createElement("span"); sp.className = "pw";
      sp.textContent = w; sp.dataset.g = idx; sp.dataset.skill = tagWord(w);
      box.appendChild(sp); box.appendChild(document.createTextNode(" "));
      idx++;
    });
  });
  probes[key] = makeProbe(prefix, box, (lastIdx, elapsed)=>{
    const ws = [...box.querySelectorAll(".pw")];
    ws.forEach(s=>{ if(+s.dataset.g > lastIdx) s.classList.add("beyond"); });
    const read = ws.filter(s=>+s.dataset.g <= lastIdx);
    const errs = read.filter(s=>s.classList.contains("err"));
    const tally = {}; errs.forEach(s=>{ tally[s.dataset.skill]=(tally[s.dataset.skill]||0)+1; });
    const missedWords = [...new Set(errs.map(s=>s.textContent))];
    const allItems = ws.map(s=>({ g:+s.dataset.g, text:s.textContent, skill:s.dataset.skill, err:s.classList.contains("err"), read:+s.dataset.g<=lastIdx }));
    S.parts[key] = { read:read.length, errors:errs.length, elapsed, wcpm:Math.round((read.length-errs.length)/elapsed*60), acc:read.length? Math.round((read.length-errs.length)/read.length*1000)/10 : 0, tally, missedWords, allItems };
  });
